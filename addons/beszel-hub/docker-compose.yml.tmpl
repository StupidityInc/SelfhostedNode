services:
  beszel-hub:
    image: henrygd/beszel:latest
    container_name: beszel-hub
    restart: unless-stopped
    ports:
      # Bind address is substituted from .env at install time. Default
      # is the Tailscale IP (100.x), with 127.0.0.1 as a fallback. NEVER
      # 0.0.0.0 unless the operator explicitly set BESZEL_HUB_BIND=0.0.0.0
      # (the addon prints a WARN in that case).
      - "${BESZEL_HUB_BIND:?BESZEL_HUB_BIND required}:${BESZEL_HUB_PORT:-8090}:8090"
    volumes:
      - ./beszel_data:/var/lib/beszel
    env_file:
      - .env
